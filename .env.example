# 6FIGS.XYZ backend env — copy to .env and fill in. The backend REFUSES to boot
# if any REQUIRED var is missing (fail-fast, no silent fallbacks).
#
# REQUIRED:
#   DATABASE_URL     Postgres connection string (Render dashboard → your DB).
#   JWT_SECRET       Long random string for session tokens. Generate with:
#                      node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#                    NEVER commit the real value. Rotating it logs everyone out.
#   REDIS_URL        Redis connection string. Backend will not start without it.
#   CHAIN_MODE       devnet | prod. Devnet = Solana devnet, tiny tiers.
#
# OPTIONAL:
#   COINGECKO_API_KEY  CoinGecko demo key — raises rate limits. Works keyless at
#                      low volume; on 429 the server serves stale cached cards.
#   PORT               HTTP port (default 4000).
#   WEB_ORIGIN         Frontend origin for CORS + WS (default http://localhost:3000).
#
# TEE VERIFICATION (required for /eligibility/tee-*; the rest of the app
# boots without them):
#   SIXFIGS_ENCLAVE_URL          Enclave base URL, e.g. http://<vm-ip>:8080.
#   SIXFIGS_IMAGE_DIGEST         Pinned workload digest (sha256:...), comma list.
#   SIXFIGS_GCP_PROJECT          Pinned GCP project id, comma list.
#   SIXFIGS_ALLOWED_NULLIFIER_SCHEMES  Default keyed-v1.
#   SIXFIGS_EXPECTED_POLICY_VERSION    Default from @sixfigs/tee/shared.
#   SIXFIGS_REQUIRED_SUPPORT_ATTRS     e.g. STABLE. Empty = skip.
#   SIXFIGS_REQUIRED_ESCROW_KEY_PROVIDERS  e.g. kms. Empty = accept env/none.
#   SIXFIGS_ALLOW_MOCK            Set to 1 only for local mock-attestation dev.
#   TEE_RECHECK_TTL_MS            Freshness TTL before silent re-verification (default 3600000).
#
SIXFIGS_ENCLAVE_URL=
SIXFIGS_IMAGE_DIGEST=
SIXFIGS_GCP_PROJECT=
SIXFIGS_ALLOWED_NULLIFIER_SCHEMES=
SIXFIGS_EXPECTED_POLICY_VERSION=
SIXFIGS_REQUIRED_SUPPORT_ATTRS=
SIXFIGS_REQUIRED_ESCROW_KEY_PROVIDERS=
SIXFIGS_ALLOW_MOCK=
TEE_RECHECK_TTL_MS=


DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
JWT_SECRET=change-me-in-production
REDIS_URL=redis://127.0.0.1:6379
CHAIN_MODE=devnet
COINGECKO_API_KEY=
PORT=4000
WEB_ORIGIN=http://localhost:3000
