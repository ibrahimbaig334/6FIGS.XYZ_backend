// 6FIGS models per PRD §8 (Modules 2–5).
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         String            @id @default(cuid())
  handle     String?           @unique
  // Optional device-free login. Set in profile; wallet recovery re-issues it.
  username   String?           @unique
  passwordHash String?
  // Bumped on password change/reset; JWT guard rejects older tokens.
  passwordChangedAt DateTime?
  visMode    String            @default("HIDDEN")
  tags       String[]          @default([])
  isBot      Boolean           @default(false)
  createdAt  DateTime  @default(now())
  eligibility EligibilityCache?
  teeIdentity TeeIdentity?
  sentMessages Message[]       @relation("SentMessages")
  roomMemberships RoomMember[]
  createdRooms Room[]          @relation("CreatedRooms")
}

model EligibilityCache {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier       String
  verifiedAt DateTime @default(now())
  expiresAt  DateTime
}

// Attested wealth identity produced by the tee. Holds no address, balance,
// or amount: tier facts, at most three disclosed symbols, opaque nullifiers,
// and an escrow blob that only the enclave can decrypt. Written only from
// verified `SignedRegistration` payloads; read paths serve these rows without
// any balance computation.
model TeeIdentity {
  userId            String   @id
  identityNullifier String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier              Int
  tierLabel         String
  portfolioBand     String
  topAssets         Json
  policyVersion     String
  escrowBlob        String
  verifiedAt        DateTime
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  bindings          TeeWalletBinding[]
}

model TeeWalletBinding {
  walletNullifier   String @id
  identityNullifier String
  identity          TeeIdentity @relation(fields: [identityNullifier], references: [identityNullifier], onDelete: Cascade)
  family            String
  label             String?
  createdAt         DateTime @default(now())

  @@index([identityNullifier])
}

model Room {
  id             String       @id @default(cuid())
  name           String
  description    String?
  imageUrl       String?
  accessType     String       // "tier" | "invite"
  minTier        String?
  minToken       String?      // optional holdings gate: symbol must be in the joiner's top assets
  maxMembers     Int          @default(2)
  inviteCodeHash String?
  createdBy      String
  creator        User         @relation("CreatedRooms", fields: [createdBy], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  members        RoomMember[]
}

model RoomMember {
  roomId   String
  room     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@id([roomId, userId])
}

model Match {
  id        String   @id @default(cuid())
  aUserId   String
  bUserId   String
  status    String   @default("open")
  origin    String   @default("challenge") // "random" | "challenge" | "room"
  createdAt DateTime @default(now())
  games     Game[]

  @@index([aUserId])
  @@index([bUserId])
}

// Random-match waiting tickets (auto-expire after 2 min, cleaned on attempt).
model QueueTicket {
  userId    String   @id
  createdAt DateTime @default(now())
}

// Mutual chat friendship: random-matched pair with ≥1 DM each. Ordered pair.
model Friendship {
  aUserId   String
  bUserId   String
  createdAt DateTime @default(now())

  @@id([aUserId, bUserId])
}

// 1v1 room invitations between friends.
model RoomRequest {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  status     String   @default("pending") // pending | accepted | declined | cancelled
  roomId     String? // legacy (random/friend matches no longer create rooms)
  matchId    String?
  gameId     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([toUserId, status])
  @@index([fromUserId, status])
}

model Game {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  board     String   @default(".........")
  turn      String   @default("X")
  status    String   @default("open")
  winner    String?
  updatedAt DateTime @updatedAt
}

model Message {
  id        String   @id @default(cuid())
  scope     String   // "dm" | "room"
  scopeId   String
  senderId  String
  sender    User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([scope, scopeId, createdAt])
}

model TokenCardCache {
  symbol    String   @id
  payload   Json
  fetchedAt DateTime @default(now())
}
